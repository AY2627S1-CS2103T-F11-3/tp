@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam dpi 150

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant ":Model" as model MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : "delete 1"

ui -[UI_COLOR]> logic : execute("delete 1")

note over logic : Parse command; deletion requires persistence.
logic -> model : getAddressBook()
model --> logic : addressBook
note over logic : Copy addressBook as beforeCommand.

logic -> model : getFilteredPersonList()
model --> logic : displayedPlayers
note over logic : Resolve player p at displayed index 1.

logic -[LOGIC_COLOR]> model : deletePerson(p)

model -[MODEL_COLOR]-> logic

logic -> model : getAddressBook()
model --> logic : updatedAddressBook

logic -[LOGIC_COLOR]> storage : saveAddressBook(updatedAddressBook)

alt Save succeeds
    storage --> logic
    logic --> ui : CommandResult
    ui --> user : Deletion feedback
else Save throws IOException
    storage --> logic : IOException
    logic -> model : setAddressBook(beforeCommand)
    model --> logic
    logic --> ui : CommandException
    ui --> user : Save error; player data restored
end
@enduml
