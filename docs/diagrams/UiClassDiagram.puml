@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam dpi 150
skinparam groupInheritance 2

package UI as UiPackage {
Class "<<interface>>\nUi" as Ui
abstract class UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class PersonListPanel
Class OverviewPanel
Class StatusBarFooter
Class CommandBox
}

package Model as ModelPackage {
Class Person MODEL_COLOR
Class ClubOverview MODEL_COLOR
Class SquadSummary MODEL_COLOR
}

package Logic {
Class "<<interface>>\nLogic" as LogicApi LOGIC_COLOR
}

package JavaFX as JavaFxPackage {
Class ScrollPane #555555
}

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "1" HelpWindow

MainWindow ..> OverviewPanel : <<create>>

MainWindow -down-|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonListPanel --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart
OverviewPanel -down-|> ScrollPane

PersonListPanel .down.> Person
OverviewPanel .down.> ClubOverview
OverviewPanel .down.> SquadSummary
UiManager -up-> LogicApi
MainWindow -up-> LogicApi

PersonListPanel -[hidden]left- HelpWindow
HelpWindow -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter

UiPart -[hidden]down-> Person
ScrollPane -[hidden]right-> SquadSummary
Person -[hidden]right-> ClubOverview
ClubOverview -[hidden]right-> SquadSummary
@enduml
